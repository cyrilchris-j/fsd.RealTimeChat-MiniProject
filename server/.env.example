EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_FROM="Real-Time Chat <your_email@gmail.com>"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

