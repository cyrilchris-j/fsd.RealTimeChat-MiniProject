PORT=5001
MONGO_URI=mongodb://localhost:27017/realtime-chat
JWT_SECRET=your_super_secret_jwt_key_change_in_production
CLIENT_URL=http://localhost:5173

# Email Service (Nodemailer - Gmail / SMTP)
EMAIL_SERVICE=gmail
